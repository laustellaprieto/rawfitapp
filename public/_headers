# Cloudflare Pages: el service worker y el manifest nunca se guardan en caché,
# así la app detecta sus versiones nuevas.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache
# Archivos con nombre único por versión: se pueden guardar mucho tiempo.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
