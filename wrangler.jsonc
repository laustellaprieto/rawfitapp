// Cloudflare Workers: publica la carpeta dist/ como sitio estático.
// Cloudflare ejecuta "npm run build" y luego "npx wrangler deploy" con esta configuración.
{
  "name": "rawfitapp",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
